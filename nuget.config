<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear inherited machine/user sources so restore is reproducible on any
         developer machine and in CI. Without this, an unreachable private feed
         configured globally fails restore. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Also cleared: a machine-level source mapping otherwise silently
         excludes nuget.org and every package fails to resolve with NU1100. -->
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
